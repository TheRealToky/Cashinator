# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock.bak
*.iml

# The lockfile IS committed: this app ships to one tablet and the exact
# dependency set is part of what was tested.
!pubspec.lock

# Generated platform scaffolding is committed so the APK build is reproducible,
# but local Gradle and signing state is not.
android/.gradle/
android/local.properties
android/key.properties
android/app/upload-keystore.jks
*.keystore
*.jks

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Test output — regenerated by `flutter test`.
build/test_exports/
coverage/

# Local device backups
backup_exports/

